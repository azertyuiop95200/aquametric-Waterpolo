APP_NAME=AquaMetric
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///./aquametric.db
UPLOAD_DIR=./uploads
EVIDENCE_DIR=./evidence
MAX_UPLOAD_MB=1024
COOKIE_SECURE=0

# Official competition-data refresh.
# Keep disabled for an offline/local PC. Enable on an internet-connected always-on deployment.
AUTO_REFRESH_OFFICIAL_DATA=0
OFFICIAL_REFRESH_LOOP_MINUTES=30
OFFICIAL_DATA_HTTP_TIMEOUT=10

# Optional scoreboard OCR. Leave blank when `tesseract` is already on PATH.
TESSERACT_CMD=
